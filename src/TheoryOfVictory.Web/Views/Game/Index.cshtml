@{
    ViewData["Title"] = "La guerre comme génération de force";
}

<header class="masthead">
    <div class="brand">
        <div class="brand-mark">TV</div>
        <div>
            <h1>Theory of Victory</h1>
            <p class="subtitle">You have the cards in hand</p>
        </div>
    </div>
    <div class="variant-picker" id="variantPicker"></div>
</header>

<nav class="timeline">
    <button type="button" class="step" id="prevTurn" aria-label="Tour précédent">◀</button>
    <div class="ticks" id="turnTicks"></div>
    <button type="button" class="step" id="nextTurn" aria-label="Tour suivant">▶</button>
</nav>

<nav class="phases" id="phasePicker">
    <button type="button" class="phase active" data-phase="0">
        <span class="p-num">1</span>
        <span class="p-body"><strong>Génération de force</strong><em>Russie</em></span>
    </button>
    <button type="button" class="phase" data-phase="1">
        <span class="p-num">2</span>
        <span class="p-body"><strong>Génération de force</strong><em>Ukraine</em></span>
    </button>
    <button type="button" class="phase" data-phase="2">
        <span class="p-num">3</span>
        <span class="p-body"><strong>Résolution</strong><em>Champ de bataille</em></span>
    </button>
</nav>

<main id="stage"></main>

@section Scripts {
    <script>
        window.tovGames = @Html.Raw(ViewBag.GamesJson);
        window.tovBoard = @Html.Raw(ViewBag.BoardJson);
        window.tovCurrentTurn = @ViewBag.CurrentTurn;
    </script>
    <script src="~/js/geography.js" asp-append-version="true"></script>
    <script src="~/js/hexmap.js" asp-append-version="true"></script>
    <script src="~/js/board.js" asp-append-version="true"></script>
}
