@using TheoryOfVictory.Core
@using TheoryOfVictory.Core.Localization
@model TheoryOfVictory.Core.HistoricalFigure
@{
    ViewData["Title"] = Model.Label;
    List<FigureSource> sources = ViewBag.Sources as List<FigureSource> ?? [];

    string badge(string confidence) => confidence switch
    {
        "Haute" => "high",
        "Moyenne" => "mid",
        _ => "low",
    };

    // The three confidence marks and the five kinds of source are written out in the data file
    // and printed as they are. They go through a branch per value rather than Loc(variable):
    // a key nobody can read in the code is a key the inventory never sees, and it ships
    // untranslated without anything saying so. An unknown value prints as it stands.
    string confidenceLabel(string confidence) => confidence switch
    {
        "Haute" => Localizer.Loc("Haute"),
        "Moyenne" => Localizer.Loc("Moyenne"),
        "Basse" => Localizer.Loc("Basse"),
        _ => confidence,
    };

    string kindLabel(string kind) => kind switch
    {
        "Mesure publiée" => Localizer.Loc("Mesure publiée"),
        "Lecture graphique" => Localizer.Loc("Lecture graphique"),
        "Estimation" => Localizer.Loc("Estimation"),
        "Estimation d'un tiers" => Localizer.Loc("Estimation d'un tiers"),
        "Document budgétaire" => Localizer.Loc("Document budgétaire"),
        _ => kind,
    };
}

<article class="prov">
    <nav class="prov-back">
        <a href="index.html">@Localizer.Loc("← Le plateau")</a>
        <partial name="_LanguagePicker" />
    </nav>

    <header class="prov-head">
        <p class="prov-kicker">@Localizer.Loc("D'où vient ce chiffre")</p>
        <h1>@Model.Label</h1>
    </header>

    <section class="prov-block">
        <h2>@Localizer.Loc("Les sources")</h2>
        @if (sources.Count == 0)
        {
            <p class="prov-empty">@Localizer.Loc("Aucune. Ce chiffre n'est soutenu par rien de publié.")</p>
        }
        else
        {
            <ol class="prov-sources">
                @foreach (FigureSource source in sources)
                {
                    <li>
                        <p class="ps-title">
                            @if (source.Url is not null)
                            {
                                <a href="@source.Url" rel="noreferrer">@source.Title</a>
                            }
                            else
                            {
                                @source.Title
                            }
                        </p>
                        <p class="ps-org">
                            @source.Organisation · @kindLabel(source.Kind)
                            @if (source.StatedUpdate is not null)
                            {
                                <text> · @source.StatedUpdate</text>
                            }
                            @if (source.Capture is not null)
                            {
                                <text> · @Localizer.Loc("relevée le %1", source.Capture)</text>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(source.Note))
                        {
                            <p class="ps-note">@source.Note</p>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    <section class="prov-block wide">
        <h2>@Localizer.Loc("Les observations")</h2>

        @* Une table à cinq colonnes imposait une grille à des lignes qui n'en sont pas une :
           quatre cellules courtes, une cinquième portant un paragraphe, et donc du vide à
           gauche sur toute la hauteur du texte. Chaque observation est un bloc — sa date et son
           chiffre tiennent la gouttière, le raisonnement occupe la largeur. La ligne que le
           moteur retient se distingue par sa teinte et par son étiquette, plus par une colonne
           où l'on écrivait « oui » quatorze fois. *@
        <ol class="obs-list">
            @foreach (FigureObservation observation in Model.Observations)
            {
                <li class="obs @(observation.Retained ? "kept" : "")">
                    <div class="obs-rail">
                        <p class="obs-date">@observation.DateLabel</p>
                        <p class="obs-value">
                            @observation.Value.ToString("N1").Replace("-", "−")<span class="u">@observation.UnitLabel</span>
                        </p>
                    </div>
                    <div class="obs-body">
                        <p class="obs-tags">
                            <span class="prov-badge @badge(observation.Confidence)">@confidenceLabel(observation.Confidence)</span>
                            @if (observation.Retained)
                            {
                                <span class="obs-kept">@Localizer.Loc("retenue par le moteur")</span>
                            }
                        </p>
                        <p class="obs-why">@observation.Why</p>
                        @if (!string.IsNullOrWhiteSpace(observation.ConfidenceWhy))
                        {
                            <p class="conf-why">@observation.ConfidenceWhy</p>
                        }
                    </div>
                </li>
            }
        </ol>
    </section>

    <nav class="prov-back"><a href="provenance.html">@Localizer.Loc("Tous les chiffres →")</a></nav>
</article>
