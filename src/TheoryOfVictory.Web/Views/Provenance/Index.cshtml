@using TheoryOfVictory.Core
@model TheoryOfVictory.Core.ProvenanceRegistry
@{
    ViewData["Title"] = "D'où viennent les chiffres";
}

<article class="prov">
    <nav class="prov-back"><a href="index.html">← Le plateau</a></nav>

    <header class="prov-head">
        <p class="prov-kicker">D'où viennent les chiffres</p>
        <h1>@Model.Figures.Count chiffre@(Model.Figures.Count > 1 ? "s" : "") documenté@(Model.Figures.Count > 1 ? "s" : "")</h1>
    </header>

    <p>
        Un chiffre entre ici quand une observation datée le soutient, et pas avant. Tous les
        autres postes du plateau sont des constantes de scénario : leur page le dit, et c'est
        tout ce qu'elle a à dire.
    </p>

    <div class="prov-scroll">
        <table class="prov-table">
            <thead>
                <tr><th>Chiffre</th><th>Camp</th><th>Observations</th><th>Sources</th></tr>
            </thead>
            <tbody>
                @foreach (HistoricalFigure figure in Model.Figures)
                {
                    <tr>
                        <td><a href="provenance-@(figure.Code).html">@figure.Label</a></td>
                        <td>@(figure.EngineSide == "invader" ? "Russie" : "Ukraine")</td>
                        <td class="num">@figure.Observations.Count</td>
                        <td class="num">@Model.SourcesOf(figure).Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</article>
