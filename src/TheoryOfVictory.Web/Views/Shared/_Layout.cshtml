@using TheoryOfVictory.Core.Localization
@using TheoryOfVictory.Web.Services
<!DOCTYPE html>
<html lang="@Languages.Code(Localizer.Current)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Theory of Victory</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/capital.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/provenance.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()
    <script>
        window.tovModel = @Html.Raw(JsModel.Render(Localizer.Current));
    </script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
